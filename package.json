{
  "name": "shopify-alt-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/run.js",
    "dry": "cross-env DRY_RUN=true node src/run.js",
    "live": "cross-env DRY_RUN=false node src/run.js",
    "descriptions": "node src/runDescriptions.js",
    "descriptions:dry": "cross-env DRY_RUN=true node src/runDescriptions.js",
    "descriptions:live": "cross-env DRY_RUN=false node src/runDescriptions.js",
    "ai": "node src/runAdvancedAI.js",
    "ai:dry": "cross-env DRY_RUN=true node src/runAdvancedAI.js",
    "ai:live": "cross-env DRY_RUN=false node src/runAdvancedAI.js",
    "scheduled": "node src/scheduledAI.js",
    "scheduled:dry": "cross-env DRY_RUN=true node src/scheduledAI.js",
    "scheduled:live": "cross-env DRY_RUN=false node src/scheduledAI.js",
    "scheduler": "node src/scheduler.js",
    "scheduler:start": "cross-env CHECK_INTERVAL_HOURS=24 node src/scheduler.js"
  },

  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "p-limit": "^5.0.0",
    "openai": "^4.58.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
